Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Map1
        - /LaserScan1
        - /TF1
      Splitter Ratio: 0.5
    Tree Height: 300
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Expanded:
      - /2D Goal Pose1
      - /2D Pose Estimate1
    Name: Tool Properties
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Name: Grid
      Normal Cell Count: 0
      Plane: XY
      Plane Cell Count: 10
      Reference Frame: <Fixed Frame>
      Value: true
    - Alpha: 0.7
      Class: rviz_default_plugins/Map
      Enabled: true
      Name: SLAM Map
      Topic:
        Value: /map
      Update Topic:
        Value: /map_updates
      Value: true
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Class: rviz_default_plugins/LaserScan
      Enabled: true
      Name: LaserScan
      Topic:
        Value: /scan
      Size (Pixels): 3
      Style: Points
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/RobotModel
      Enabled: true
      Name: RobotModel
      Robot Description: robot_description
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Marker Scale: 0.3
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Value: true
    - Alpha: 0.7
      Class: rviz_default_plugins/Map
      Enabled: true
      Name: Global Costmap
      Topic:
        Value: /global_costmap/costmap
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Frontier Markers
      Topic:
        Value: /explore/frontiers
      Value: true
    - Class: rviz_default_plugins/Pose
      Enabled: true
      Name: Selected Frontier
      Topic:
        Value: /explore/selected_frontier
      Value: true
    - Class: rviz_default_plugins/Path
      Color: 0; 220; 255
      Enabled: true
      Line Style: Billboards
      Line Width: 0.035
      Name: Mission Global Plan
      Topic:
        Durability Policy: Transient Local
        Value: /mission/global_path
      Value: true
    - Class: rviz_default_plugins/Path
      Color: 255; 170; 0
      Enabled: true
      Line Style: Billboards
      Line Width: 0.025
      Name: Mission Actual Trajectory
      Topic:
        Durability Policy: Transient Local
        Value: /mission/actual_path
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
  Value: true
Views:
  Current:
    Class: rviz_default_plugins/Orbit
    Distance: 15
    Focal Point:
      X: 0
      Y: 0
      Z: 0
    Name: Current View
    Near Clip Distance: 0.01
    Pitch: 0.785
    Target Frame: <Fixed Frame>
    Value: Orbit (rviz)
    Yaw: 0.785
Window Geometry:
  Height: 900
  Width: 1400
